[Unit]
Description=Aorus Langfuse clickhouse
PartOf=langfuse.target
After=langfuse-prepare.service
Requires=langfuse-prepare.service
StartLimitIntervalSec=0

[Container]
Image=docker.io/clickhouse/clickhouse-server:26.9.9.28@sha256:402d385614cb9ba0214b5d9262e4c9cfe3d9fdc832bbbaca20d62a233eb0d9c4
Pull=never
ContainerName=aorus-langfuse-clickhouse
Network=langfuse.network
NetworkAlias=clickhouse
GlobalArgs=--cgroup-manager=systemd
CgroupsMode=split
LogDriver=journald
PidsLimit=1024
User=101:101
EnvironmentFile=%h/.config/aorus-langfuse/clickhouse.env
Volume=/mnt/aorus/langfuse/clickhouse:/var/lib/clickhouse:Z
Volume=/mnt/aorus/langfuse/clickhouse-logs:/var/log/clickhouse-server:Z
Volume=%h/.config/aorus-langfuse/clickhouse.xml:/etc/clickhouse-server/config.d/aorus.xml:ro,Z
Volume=%h/.config/aorus-langfuse/clickhouse-users.xml:/etc/clickhouse-server/users.d/aorus.xml:ro,Z
Ulimit=nofile=262144:262144
HealthCmd=wget --no-verbose --tries=1 --spider http://127.0.0.1:8123/ping
HealthInterval=10s
HealthRetries=12
HealthOnFailure=kill
Notify=healthy

[Service]
Slice=langfuse.slice
Restart=always
RestartSec=10
TimeoutStartSec=180
TimeoutStopSec=90

[Install]
WantedBy=langfuse.target
