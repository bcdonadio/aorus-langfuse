[Unit]
Description=Aorus Langfuse loki
PartOf=langfuse.target
After=langfuse-prepare.service
Requires=langfuse-prepare.service
StartLimitIntervalSec=0

[Container]
Image=docker.io/grafana/loki:3.7.7@sha256:d70e4659623f3e109af669cae76fe2a5dd5be54e2298fe8aed380d982fbc2500
Pull=never
ContainerName=aorus-langfuse-loki
Network=langfuse.network
NetworkAlias=loki
GlobalArgs=--cgroup-manager=systemd
CgroupsMode=split
LogDriver=journald
PidsLimit=1024
User=10001:10001
Environment=GOMEMLIMIT=1536MiB
Volume=%h/.config/aorus-langfuse/loki.yaml:/etc/loki/config.yaml:ro,Z
Volume=/mnt/aorus/langfuse/loki:/loki:Z
Exec=-config.file=/etc/loki/config.yaml

[Service]
Slice=langfuse.slice
Restart=always
RestartSec=10
TimeoutStartSec=180
TimeoutStopSec=90

[Install]
WantedBy=langfuse.target
