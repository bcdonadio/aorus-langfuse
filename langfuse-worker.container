[Unit]
Description=Aorus Langfuse langfuse-worker
PartOf=langfuse.target
After=langfuse-prepare.service
Requires=langfuse-prepare.service langfuse-bootstrap.service
After=langfuse-postgres.service langfuse-clickhouse.service langfuse-redis.service langfuse-minio.service langfuse-bootstrap.service
Wants=langfuse-postgres.service langfuse-clickhouse.service langfuse-redis.service langfuse-minio.service langfuse-bootstrap.service
StartLimitIntervalSec=0

[Container]
Image=docker.langfuse.com/langfuse/langfuse-worker:4.50.0@sha256:52f7fd41ded2f1a6acab13ff7cb1832d36dfe2cbf44adea402b7a09cfa4ce800
Pull=never
ContainerName=aorus-langfuse-langfuse-worker
Network=langfuse.network
NetworkAlias=langfuse-worker
GlobalArgs=--cgroup-manager=systemd
CgroupsMode=split
LogDriver=journald
PidsLimit=1024
EnvironmentFile=%h/.config/aorus-langfuse/langfuse.env
Environment=LANGFUSE_LOG_LEVEL=warn
Environment=LANGFUSE_BACKGROUND_MIGRATION_V4_DROP_PID_TID_SORTING_TABLES=true
Environment=NODE_OPTIONS=--max-old-space-size=1536
HealthCmd=node -e "fetch('http://langfuse-worker:3030/api/health?failIfQueueConsumptionStuck=true').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
HealthInterval=30s
HealthStartPeriod=120s
HealthRetries=6
HealthOnFailure=kill
Notify=healthy

[Service]
Slice=langfuse.slice
Restart=always
RestartSec=10
TimeoutStartSec=900
TimeoutStopSec=90

[Install]
WantedBy=langfuse.target
