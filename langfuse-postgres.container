[Unit]
Description=Aorus Langfuse postgres
PartOf=langfuse.target
After=langfuse-prepare.service
Requires=langfuse-prepare.service
StartLimitIntervalSec=0

[Container]
Image=docker.io/library/postgres:18.6@sha256:5a5a84b19854a9ffaa54082c166ff4ec27473a361e496e5ea167f298f2da9722
Pull=never
ContainerName=aorus-langfuse-postgres
Network=langfuse.network
NetworkAlias=postgres
GlobalArgs=--cgroup-manager=systemd
CgroupsMode=split
LogDriver=journald
PidsLimit=1024
EnvironmentFile=%h/.config/aorus-langfuse/postgres.env
Volume=/mnt/aorus/langfuse/postgres:/var/lib/postgresql:Z
Exec=postgres -c shared_buffers=256MB -c max_connections=60 -c work_mem=8MB -c timezone=UTC
HealthCmd=pg_isready -U langfuse -d langfuse
HealthInterval=10s
HealthRetries=12
HealthOnFailure=kill
Notify=healthy

[Service]
Slice=langfuse.slice
Restart=always
RestartSec=10
TimeoutStartSec=180
TimeoutStopSec=90

[Install]
WantedBy=langfuse.target
