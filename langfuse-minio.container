[Unit]
Description=Aorus Langfuse minio
PartOf=langfuse.target
After=langfuse-prepare.service
Requires=langfuse-prepare.service
StartLimitIntervalSec=0

[Container]
Image=cgr.dev/chainguard/minio@sha256:ad4a4c0a39ad7b71408124fe3df07b1b2e9d2959a369fac8754d2ef3311b5c20
Pull=never
ContainerName=aorus-langfuse-minio
Network=langfuse.network
NetworkAlias=minio
GlobalArgs=--cgroup-manager=systemd
CgroupsMode=split
LogDriver=journald
PidsLimit=1024
EnvironmentFile=%h/.config/aorus-langfuse/minio.env
Volume=/mnt/aorus/langfuse/minio:/data:Z
PublishPort=127.0.0.1:9000:9000
Exec=server --address :9000 --console-address :9001 /data
HealthCmd=mc ready local
HealthInterval=10s
HealthRetries=12
HealthOnFailure=kill
Notify=healthy

[Service]
Slice=langfuse.slice
Restart=always
RestartSec=10
TimeoutStartSec=180
TimeoutStopSec=90

[Install]
WantedBy=langfuse.target
